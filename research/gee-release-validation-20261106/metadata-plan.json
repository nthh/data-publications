{
  "schema_version": 1,
  "purpose": "Metadata-only GEE counterpart discovery before fixed comparison criteria. No feature values requested.",
  "authorization": "User requested continuation of GEE validation for prepared releases before reviewing the repository; no product publication authorized.",
  "quota_project": "mtnmap-f75ec",
  "limits": {
    "maximum_requests": 12,
    "maximum_total_bytes": 10000000,
    "maximum_response_bytes": 2000000,
    "timeout_seconds": 45,
    "maximum_elapsed_seconds": 600
  },
  "requests": [
    {
      "id": "hydrolakes",
      "resource": "projects/earthengine-legacy/assets/projects/sat-io/open-datasets/HydroLakes/lake_poly_v10",
      "allowed_http_status": [
        200,
        403,
        404
      ]
    },
    {
      "id": "lakeatlas-polygons",
      "resource": "projects/earthengine-legacy/assets/projects/sat-io/open-datasets/HydroAtlas/LakeAtlas/LakeAtlas_v10_polygon",
      "allowed_http_status": [
        200,
        403,
        404
      ]
    },
    {
      "id": "lakeatlas-points",
      "resource": "projects/earthengine-legacy/assets/projects/sat-io/open-datasets/HydroAtlas/LakeAtlas/LakeAtlas_v10_point",
      "allowed_http_status": [
        200,
        403,
        404
      ]
    },
    {
      "id": "free-flowing-rivers",
      "resource": "projects/earthengine-public/assets/WWF/HydroSHEDS/v1/FreeFlowingRivers",
      "allowed_http_status": [
        200,
        403,
        404
      ]
    },
    {
      "id": "grwl-summary",
      "resource": "projects/earthengine-legacy/assets/projects/sat-io/open-datasets/GRWL/grwl_SummaryStats_v01_01",
      "allowed_http_status": [
        200,
        403,
        404
      ]
    },
    {
      "id": "grwl-raw",
      "resource": "projects/earthengine-legacy/assets/projects/sat-io/open-datasets/GRWL/water_vector_v01_01",
      "allowed_http_status": [
        200,
        403,
        404
      ]
    },
    {
      "id": "river-plastic-inputs",
      "resource": "projects/earthengine-legacy/assets/projects/sat-io/open-datasets/open-ocean/river_plastic_emissions",
      "allowed_http_status": [
        200,
        403,
        404
      ]
    },
    {
      "id": "grwl-folder",
      "resource": "projects/earthengine-legacy/assets/projects/sat-io/open-datasets/GRWL:listAssets",
      "params": {
        "pageSize": 100
      },
      "paginate": true,
      "maximum_pages": 3,
      "maximum_rows": 300,
      "allowed_http_status": [
        200,
        403,
        404
      ]
    }
  ],
  "references": [
    "https://developers.google.com/earth-engine/reference/rest/v1/projects.assets/get",
    "https://developers.google.com/earth-engine/reference/rest/v1/projects.assets/listFeatures",
    "https://gee-community-catalog.org/projects/grwl/"
  ]
}
