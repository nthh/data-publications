#!/usr/bin/env python3
"""Execute a committed, bounded plan of read-only GEE REST requests."""
from __future__ import annotations
import argparse
from datetime import datetime, timezone
import hashlib
import importlib.metadata
import json
from pathlib import Path
import platform
import re
import subprocess
import time
import google.auth
from google.auth.transport.requests import AuthorizedSession

ROOT = Path(__file__).resolve().parents[2]
BASE = 'https://earthengine.googleapis.com/v1/'


def sha(path):
    h = hashlib.sha256()
    with Path(path).open('rb') as f:
        for chunk in iter(lambda: f.read(1 << 20), b''):
            h.update(chunk)
    return h.hexdigest()


def stamp():
    return datetime.now(timezone.utc).isoformat()


def validate_plan(plan):
    assert plan['schema_version'] == 1
    assert re.fullmatch(r'[a-z][a-z0-9-]{4,62}', plan['quota_project'])
    limits = plan['limits']
    assert 0 < limits['maximum_requests'] <= 256
    assert 0 < limits['maximum_total_bytes'] <= 512_000_000
    assert 0 < limits['maximum_response_bytes'] <= 64_000_000
    assert 0 < limits['timeout_seconds'] <= 60
    assert 0 < limits['maximum_elapsed_seconds'] <= 7200
    names = set()
    for r in plan['requests']:
        assert re.fullmatch(r'[a-z0-9-]+', r['id']) and r['id'] not in names
        names.add(r['id'])
        assert re.fullmatch(r'projects/[A-Za-z0-9_-]+/assets/[A-Za-z0-9_./-]+(?::listFeatures|:listAssets)?', r['resource'])
        assert '..' not in r['resource']
        assert r.get('operation', 'get') in {'get', 'count'}
        if r.get('operation') == 'count':
            assert ':' not in r['resource'] and not r.get('params') and not r.get('paginate')
        assert set(r.get('params', {})) <= {'pageSize', 'filter', 'region'}
        assert 0 < r.get('maximum_pages', 1) <= 64
        assert set(r.get('allowed_http_status', [200])) <= {200, 403, 404}
    return plan


def main():
    ap = argparse.ArgumentParser(description=__doc__)
    ap.add_argument('--plan', required=True, type=Path)
    ap.add_argument('--output', required=True, type=Path)
    a = ap.parse_args()
    plan = validate_plan(json.loads(a.plan.read_text()))
    tracked = [str(Path(__file__).resolve()), str(Path(__file__).with_name('uv.lock')), str(a.plan.resolve())]
    for p in tracked:
        subprocess.check_call(['git', 'ls-files', '--error-unmatch', p], cwd=ROOT, stdout=subprocess.DEVNULL)
    if subprocess.check_output(['git', 'status', '--porcelain', '--', *tracked], cwd=ROOT, text=True).strip():
        raise SystemExit('Commit the capture code, lockfile and request plan first.')
    a.output.mkdir(parents=True, exist_ok=False)
    receipt = {'schema_version': 1, 'status': 'incomplete', 'started_at': stamp(),
        'git_commit': subprocess.check_output(['git', 'rev-parse', 'HEAD'], cwd=ROOT, text=True).strip(),
        'script_sha256': sha(__file__), 'plan_sha256': sha(a.plan),
        'lock_sha256': sha(Path(__file__).with_name('uv.lock')), 'quota_project': plan['quota_project'],
        'scope': 'Existing metadata/feature GET and bounded synchronous Collection.size only; no exports, batch tasks, writes or publication.',
        'environment': {'python': platform.python_version(), **{x: importlib.metadata.version(x) for x in ['google-auth', 'requests']}},
        'requests': [], 'total_bytes': 0, 'queries': [], 'errors': []}
    begin = time.monotonic()
    limits = plan['limits']
    try:
        creds, _ = google.auth.default(scopes=['https://www.googleapis.com/auth/cloud-platform.read-only'], quota_project_id=plan['quota_project'])
        session = AuthorizedSession(creds, max_refresh_attempts=0)
        for query in plan['requests']:
            count = 0
            tokens = set()
            params = query.get('params', {}).copy()
            terminated = False
            for page in range(1, query.get('maximum_pages', 1) + 1):
                if len(receipt['requests']) >= limits['maximum_requests'] or time.monotonic() - begin > limits['maximum_elapsed_seconds']:
                    raise ValueError('Request or elapsed-time limit reached')
                name = f"{query['id']}-{page:03d}.json"
                item = {'query': query['id'], 'method': 'POST' if query.get('operation') == 'count' else 'GET', 'resource': query['resource'], 'params': params.copy(), 'started_at': stamp(), 'response_path': name}
                receipt['requests'].append(item)
                if query.get('operation') == 'count':
                    expression = {'expression': {'result': '0', 'values': {'0': {'functionInvocationValue': {'functionName': 'Collection.size', 'arguments': {'collection': {'functionInvocationValue': {'functionName': 'Collection.loadTable', 'arguments': {'tableId': {'constantValue': query['resource']}}}}}}}}}}
                    item['body'] = expression
                    item['endpoint_resource'] = f"projects/{plan['quota_project']}/value:compute"
                    response_context = session.post(BASE + item['endpoint_resource'], json=expression, timeout=limits['timeout_seconds'], stream=True)
                else:
                    response_context = session.get(BASE + query['resource'], params=params, timeout=limits['timeout_seconds'], stream=True)
                with response_context as response:
                    buf = bytearray()
                    for chunk in response.iter_content(1 << 16):
                        if len(buf) + len(chunk) > limits['maximum_response_bytes'] or receipt['total_bytes'] + len(buf) + len(chunk) > limits['maximum_total_bytes']:
                            raise ValueError('Response byte limit reached')
                        buf.extend(chunk)
                    raw = bytes(buf)
                    (a.output / name).write_bytes(raw)
                    receipt['total_bytes'] += len(raw)
                    item.update({'http_status': response.status_code, 'finished_at': stamp(), 'response_bytes': len(raw), 'response_sha256': hashlib.sha256(raw).hexdigest(), 'headers': {k: response.headers[k] for k in ['Date', 'Content-Type', 'ETag'] if k in response.headers}})
                    print(json.dumps({'query': query['id'], 'page': page, 'http_status': response.status_code, 'bytes': len(raw)}), flush=True)
                    if response.status_code not in query.get('allowed_http_status', [200]):
                        raise ValueError(f'Unexpected HTTP {response.status_code}')
                    data = json.loads(raw)
                    if response.status_code != 200:
                        terminated = True
                        break
                count += len(data.get('features', data.get('assets', [])))
                if count > query.get('maximum_rows', 100_000):
                    raise ValueError('Query row limit reached')
                token = data.get('nextPageToken')
                if not token:
                    terminated = True
                    break
                if not query.get('paginate', False):
                    # A deliberate first-page probe is never labeled complete enumeration.
                    break
                if token in tokens:
                    raise ValueError('Repeated pagination token')
                tokens.add(token)
                params['pageToken'] = token
            if query.get('paginate', False) and not terminated:
                raise ValueError('Pagination did not terminate inside page limit')
            receipt['queries'].append({'id': query['id'], 'rows': count, 'pages': page, 'pagination_terminated': terminated, 'complete_enumeration': bool(query.get('paginate') and terminated)})
        receipt['status'] = 'complete'
    except Exception as exc:
        safe = {'type': type(exc).__name__}
        if type(exc) is ValueError:
            safe['message'] = str(exc)
        elif 'invalid_grant' in str(exc):
            safe['category'] = 'credentials_refresh_invalid_grant'
        elif 'default credentials' in str(exc).lower():
            safe['category'] = 'application_default_credentials_unavailable'
        receipt['errors'].append(safe)
    finally:
        receipt['finished_at'] = stamp()
        receipt['elapsed_seconds'] = round(time.monotonic() - begin, 3)
        (a.output / 'capture.json').write_text(json.dumps(receipt, indent=2) + '\n')
    print(json.dumps({k: receipt[k] for k in ['status', 'total_bytes', 'errors']}), flush=True)
    return 0 if receipt['status'] == 'complete' else 1


if __name__ == '__main__':
    raise SystemExit(main())
